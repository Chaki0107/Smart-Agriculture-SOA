			<db:sql ><![CDATA[INSERT INTO disease_predictions (
    crop_type,
    growth_stage,
    field_zone,
    predicted_class,
    class_1_probability,
    model,
    target,
    sensor_data,
    created_at
)
VALUES (
    :crop_type,
    :growth_stage,
    :field_zone,
    :predicted_class,
    :class_1_probability,
    :model,
    :target,
    CAST(:sensor_data AS JSONB),
    CURRENT_TIMESTAMP
);]]></db:sql>
			<db:input-parameters ><![CDATA[#[{
    crop_type: vars.sensors.crop_type,
    growth_stage: vars.sensors.growth_stage,
